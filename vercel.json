{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["src/**"]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "api/index.py"
    },
    {
      "source": "/",
      "destination": "public/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "public/$1"
    }
  ],
  "env": {
    "SERVE_STATIC_UI": "false",
    "PYTHONPATH": "."
  }
}