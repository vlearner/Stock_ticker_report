{
  "version": 2,
  "builds": [
    {
      "src": "src/api/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "src/api/app.py"
    },
    {
      "source": "/",
      "destination": "public/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "public/$1"
    }
  ],
  "env": {
    "SERVE_STATIC_UI": "false",
    "PYTHONPATH": "."
  }
}